leValues":"4"},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Customer Month Year","fieldType":"column","dataType":"2","displayFolder":"_Customer","description":"The customer month year is specific to a customer's calendar and reporting period. The customer month year takes into consideration how a customer groups together their week, month, and year.","exampleValues":"Lowe's Dec 2017"},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Customer Quarter","fieldType":"column","dataType":"2","displayFolder":"_Customer","description":"The customer month year is specific to a customer's calendar and reporting period. The customer quarter will vary as each customer's fiscal period begins at different times. For example, Walmart's Q1 is Feb - Apr. Walgreen's Q1 is Sept - Nov.","exampleValues":"Quarter 1"},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Customer Quarter Abbr","fieldType":"column","dataType":"2","displayFolder":"_Customer","description":"This is the abbreviation of the Customer Quarter field.","exampleValues":"Q1"},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Customer Quarter Number","fieldType":"column","dataType":"6","displayFolder":"_Customer","description":"\"Useful for grouping by quarter, ex. \"\"4\"\". Customer Quarter Number will be defined by filtering Calendar Type to Customer Calendar.\"","exampleValues":"4"},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Customer Week End Date","fieldType":"column","dataType":"9","displayFolder":"_Customer","description":"A customer's week end date is specific to their calendar and reporting period. This field is based on the Customer Calendar selected. For example, Costco's week runs Monday - Sunday. Therefore, you'd have to select a week ending date that lands on a Sunday if using the customer's calendar. Data would then show for Sunday - Monday.","exampleValues":"43348"},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Customer Week Number","fieldType":"column","dataType":"6","displayFolder":"_Customer","description":"\"Useful for grouping by Customer Week Number, ex. \"\"31\"\". Customer Week Number will be defined by filtering the Calendar Type to Customer Calendar. \"","exampleValues":"31"},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Customer Year","fieldType":"column","dataType":"6","displayFolder":"_Customer","description":"\"Useful for grouping by Customer year, ex. \"\"2021\"\". Customer Year will be defined by filtering the Calendar Type to Customer Calendar. \"","exampleValues":"2021"},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Customer Year Month Number","fieldType":"column","dataType":"6","displayFolder":"_Customer","description":"\"Useful for grouping by year and month number, ex. \"\"202404\"\". Customer Year Month Number will be defined by filtering Calendar Type to Customer Calendar.\"","exampleValues":"202404"},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Customer Year Week Number","fieldType":"column","dataType":"2","displayFolder":"_Customer","description":"\"Useful for grouping by year and week, ex. \"\"202114\"\". Customer Year Week Number will be defined by filtering Calendar Type to Customer Calendar.\"","exampleValues":"202114"},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Day Of Week","fieldType":"column","dataType":"2","description":"\"Useful for grouping by Day of the Week, ex \"\"Monday\"\". Day of Week will be defined by the default or based on a filter selected in the Calendar Type dimension.\"","exampleValues":"Monday"},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Month","fieldType":"column","dataType":"2","description":"\"Useful for grouping by month name, ex. \"\"April\"\". Month will be defined by the default or based on a filter selected in the Calendar Type dimension. For example","calculation":"January for Invoice Sales or Standard Calendar is Jan 1 - Jan 31. January for POS Sales or the Retail Calendar is Week 1 - Week 4.\""},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Month Abbr","fieldType":"column","dataType":"2","description":"\"Useful for grouping by month name abbreviated, \"\"ex. Apr\"\". Month will be defined by the default or based on a filter selected in the Calendar Type dimension. For example","calculation":"January for Invoice Sales or Standard Calendar is Jan 1 - Jan 31. January for POS Sales or the Retail Calendar is Week 1 - Week 4.\""},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Month Number","fieldType":"column","dataType":"6","description":"\"Useful for grouping by month number, ex. \"\"4\"\". Month will be defined by the default or based on a filter selected in the Calendar Type dimension. For example","calculation":"Jaunary for Invoice Sales or Standard Calendar is Jan 1 - Jan 31. Jaunary for POS Sales or the Retail Calendar is Week 1 - Week 4.\""},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Month Year","fieldType":"column","dataType":"2","description":"\"Useful for grouping by month abbreviated and year, ex. \"\"April 2021\"\". Month will be defined by the default or based on a filter selected in the Calendar Type dimension. For example","calculation":"January for Invoice Sales or Standard Calendar is Jan 1 - Jan 31. January for POS Sales or the Retail Calendar is Week 1 - Week 4.\""},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Quarter","fieldType":"column","dataType":"2","description":"\"Useful for grouping by quarter, ex. \"\"Quarter 2\"\". Quarter will be defined by the default or based on a filter selected in the Calendar Type dimension. For example","calculation":"Quarter 1 for Invoice Sales or Standard Calendar is Jan 1 - Mar 31. Quarter 1 for POS Sales or the Retail Calendar is Week 1 - Week 13.\""},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Quarter Abbr","fieldType":"column","dataType":"2","description":"\"Useful for grouping by quarter, ex. \"\"Q2\"\". Quarter will be defined by the default or based on a filter selected in the Calendar Type dimension. For example","calculation":"Quarter 1 for Invoice Sales or Standard Calendar is Jan 1 - Mar 31. Quarter 1 for POS Sales or the Retail Calendar is Week 1 - Week 13.\""},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Quarter Number","fieldType":"column","dataType":"6","description":"\"Useful for grouping by quarter, ex. \"\"4\"\"\"","exampleValues":"4"},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Quarter Year","fieldType":"column","dataType":"2","description":"\"Useful for grouping by quarter, ex. \"\"Q2 2021\"\". Quarter will be defined by the default or based on a filter selected in the Calendar Type dimension. For example","calculation":"Quarter 1 for Invoice Sales or Standard Calendar is Jan 1 - Mar 31. Quarter 1 for POS Sales or the Retail Calendar is Week 1 - Week 13.\""},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Reporting Date","fieldType":"column","dataType":"9","description":"Date of transaction. Reporting Date definition may change depending on the fact selected. Sales-related Facts: Reporting Date is the date of the transaction. Open Order Facts: Reporting Date is the expected ship date. Order Intake Facts: Reporting Date is the Created On Date for Sales Document.","exampleValues":"44299"},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Week End Date","fieldType":"column","dataType":"9","description":"\"Useful for grouping by week based on the 445 Calendar from Jan-Dec with Saturday Weekending, ex \"\"4/17/2021\"\"","exampleValues":"\"\"4/24/2021\"\"","additionalDetails":"44302"},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Week Number","fieldType":"column","dataType":"6","description":"Week Number associated with the historical transaction.","exampleValues":"1"},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Year","fieldType":"column","dataType":"6","description":"\"Useful for grouping by year, ex. \"\"2021\"\". Year will be defined by the default or based on a filter selected in the Calendar Type dimension. For example","calculation":"2021 for Invoice Sales or Standard Calendar is Jan 1 - Jan 31. 2021 for POS Sales or the Retail Calendar is Week 1 - Week 52.\""},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Year Month Number","fieldType":"column","dataType":"2","description":"\"Useful for grouping by year and month number, ex. \"\"202104\"\". Month will be defined by the default or based on a filter selected in the Calendar Type dimension. For example","calculation":"Jaunary for Invoice Sales or Standard Calendar is Jan 1 - Jan 31. Jaunary for POS Sales or the Retail Calendar is Week 1 - Week 4.\""},{"model":"Ent-Reporting-Profitability","table":"Time","field":"Year Week Number","fieldType":"column","dataType":"2","description":"\"Useful for grouping by year and week number based on the 445 Calendar from Jan-Dec with Saturday Weekending, ex \"\"202115\"\".\"","exampleValues":"202115"},{"model":"Ent-Reporting-Profitability","table":"Time Period","field":"Anchor Date","fieldType":"column","dataType":"9","description":"Time Periods can be used with Anchor Date, Anchor Month, Anchor Month Number, and Anchor Week End Date if a user wants to create a specific “as of” time period. Example: If Last Week is used with an Anchor Week End Date of 6/5/2021 then the Last Week would aggregate sales for 5/30/2021 – 6/5/2021. Anchor Date definition may change depending on the fact selected. Snapshot Facts: Anchor Date is the date the snapshot was taken. Example: Open Orders Snapshot with an Anchor Date selection of 6/7/2021, the data represents what Open Orders were on 6/7/2021. Non-Snapshot Facts: Anchor Date is the last date of transactions included in the time period selected. Example: Invoice Sales with an Anchor Date selection of 6/7/2021, the data represents what shipped on or before 6/7/2021 for the time period selected.","exampleValues":"44302"},{"model":"Ent-Reporting-Profitability","table":"Time Period","field":"Anchor Month","fieldType":"column","dataType":"2","description":"Time Periods created as of the anchor month.","exampleValues":"January"},{"model":"Ent-Reporting-Profitability","table":"Time Period","field":"Anchor Month Number","fieldType":"column","dataType":"6","description":"Time Periods created as of the anchor month number.","exampleValues":"1"},{"model":"Ent-Reporting-Profitability","table":"Time Period","field":"Anchor Week End Date","fieldType":"column","dataType":"9","description":"Time Periods created as of the anchor week end date.","exampleValues":"44932"},{"model":"Ent-Reporting-Profitability","table":"Time Period","field":"Anchor Week Number","fieldType":"column","dataType":"2","description":"Time Periods created as of the anchor week number.","exampleValues":"28"},{"model":"Ent-Reporting-Profitability","table":"Time Period","field":"Anchor Year","fieldType":"column","dataType":"6","description":"Time Periods created as of the anchor year.","exampleValues":"2025"},{"model":"Ent-Reporting-Profitability","table":"Time Period","field":"Anchor Year Week Number","fieldType":"column","dataType":"2","description":"Time Periods created as of the anchor year week number.","exampleValues":"202338"},{"model":"Ent-Reporting-Profitability","table":"Time Period","field":"Customer Anchor Month","fieldType":"column","dataType":"2","displayFolder":"_Customer","description":"Time Periods created as of the anchor month for a customer.","exampleValues":"Walmart February"},{"model":"Ent-Reporting-Profitability","table":"Time Period","field":"Customer Anchor Month Year","fieldType":"column","dataType":"2","displayFolder":"_Customer","description":"Time Periods created as of the anchor month year for a customer.","exampleValues":"BestBuy Nov 2023"},{"model":"Ent-Reporting-Profitability","table":"Time Period","field":"Customer Anchor Week End Date","fieldType":"column","dataType":"9","displayFolder":"_Customer","description":"Time Periods created as of the anchor week end date for a customer.","exampleValues":"44931"},{"model":"Ent-Reporting-Profitability","table":"Time Period","field":"Customer Anchor Year","fieldType":"column","dataType":"2","displayFolder":"_Customer","description":"Time Periods created as of the anchor year for a customer.","exampleValues":"2025"},{"model":"Ent-Reporting-Profitability","table":"Time Period","field":"Time Period","fieldType":"column","dataType":"2","description":"Time Periods are pre-baked collections of dates that can be used with most facts. Time Periods will always default to look backwards from the most recent refresh of data. Time Period will be defined by the default or based on a filter selected in the Calendar Type dimension. For example, YTD for Invoice Sales or Standard Calendar will include Jan 1 - Dec 31. YTD for POS Sales or the Retail Calendar will include Week 1 - Week 52.","exampleValues":"MTD, Last 4 Weeks"},{"model":"Ent-Reporting-Profitability","table":"Time Period","field":"Year Indicator","fieldType":"column","dataType":"2","description":"Indication of a specific year.","exampleValues":"CY, PY, PPY"}]